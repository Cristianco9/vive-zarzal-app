<mxfile host="app.diagrams.net">
  <diagram id="u3shNIuu7ksobTJ5IzVv" name="classes-diagram">
    <mxGraphModel dx="3963" dy="3306" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================================\n    %% UML LEGEND\n    %% +  public        -  private        #  protected\n    %% $  static op     *  abstract op\n    %% &lt;|--  generalization     *--  composition\n    %% o--   aggregation        --   association\n    %% &lt;&lt;Model&gt;&gt;       Sequelize domain entity\n    %% &lt;&lt;JoinTable&gt;&gt;   association entity (n:m with attributes)\n    %% &lt;&lt;Enumeration&gt;&gt; enumerated domain values\n    %% ==========================================================\n\n    %% ----------------------------------------------------------\n    %% ABSTRACT BASE CLASS\n    %% ----------------------------------------------------------\n\n    class Model {\n        &lt;&lt;abstract&gt;&gt;\n        &lt;&lt;Sequelize&gt;&gt;\n        +Number id\n        +Date   createdAt\n        +Date   updatedAt\n        +create(values, options) Model$\n        +bulkCreate(data, options) Model[]$\n        +findByPk(id, options) Model$\n        +findOne(options) Model$\n        +findAll(options) Model[]$\n        +count(options) Number$\n        +save(options) Model\n        +update(values, options) Number\n        +destroy(options) void\n        +validate(options) void\n        +toJSON() Object\n    }\n\n    %% ----------------------------------------------------------\n    %% ENUMERATIONS\n    %% ----------------------------------------------------------\n\n    class PublicationType {\n        &lt;&lt;Enumeration&gt;&gt;\n        dish\n        recipe\n    }\n\n    class ReportStatus {\n        &lt;&lt;Enumeration&gt;&gt;\n        pending\n        approved\n        dismissed\n    }\n\n    %% ----------------------------------------------------------\n    %% CORE FORUM\n    %% ----------------------------------------------------------\n\n    class User {\n        &lt;&lt;Model&gt;&gt;\n        +String firstName\n        +String lastName\n        +String username\n        +String email\n        +String password\n        +String bio\n        +Publication[] publications\n        +Like[] likes\n        +Rating[] ratings\n        +Comment[] comments\n        +Favorite[] favorites\n        +Notification[] notifications\n        +Role[] roles\n        +UserRole[] userRoles\n        +UserDocument[] documents\n        +UserAddress[] addresses\n        +Report[] submittedReports\n        +Report[] reviewedReports\n        +addRole(role) void\n        +removeRole(role) void\n        +getRoles(options) Role[]\n        +hasRole(role) Boolean\n    }\n\n    class Category {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String slug\n        +String description\n        +Publication[] publications\n    }\n\n    class Publication {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number categoryId\n        +PublicationType type\n        +String title\n        +String description\n        +String imageUrl\n        +String ingredients\n        +String instructions\n        +User author\n        +Category category\n        +Like[] likes\n        +Rating[] ratings\n        +Comment[] comments\n        +Favorite[] favorites\n        +Tag[] tags\n        +PublicationTag[] tagLinks\n        +Notification[] notifications\n        +Report[] reports\n    }\n\n    class Like {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number publicationId\n        +User user\n        +Publication publication\n    }\n\n    class Rating {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number publicationId\n        +Number score {1..5}\n        +User user\n        +Publication publication\n        +validateScore() Boolean\n    }\n\n    class Comment {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number publicationId\n        +String content\n        +User author\n        +Publication publication\n        +Report[] reports\n    }\n\n    %% ----------------------------------------------------------\n    %% ACCESS CONTROL\n    %% ----------------------------------------------------------\n\n    class Role {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String slug\n        +String description\n        +Boolean isSystem\n        +User[] users\n        +Permission[] permissions\n        +UserRole[] userRoles\n        +RolePermission[] rolePermissions\n    }\n\n    class Permission {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String slug\n        +String description\n        +Role[] roles\n        +RolePermission[] rolePermissions\n    }\n\n    class UserRole {\n        &lt;&lt;JoinTable&gt;&gt;\n        +Number userId\n        +Number roleId\n        +User user\n        +Role role\n    }\n\n    class RolePermission {\n        &lt;&lt;JoinTable&gt;&gt;\n        +Number roleId\n        +Number permissionId\n        +Role role\n        +Permission permission\n    }\n\n    %% ----------------------------------------------------------\n    %% IDENTITY\n    %% ----------------------------------------------------------\n\n    class DocumentType {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String code\n        +String description\n        +Boolean isActive\n        +UserDocument[] userDocuments\n    }\n\n    class UserDocument {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number documentTypeId\n        +String documentNumber\n        +Date issuedAt\n        +Date expiresAt\n        +Boolean isVerified\n        +Date verifiedAt\n        +User user\n        +DocumentType documentType\n    }\n\n    %% ----------------------------------------------------------\n    %% LOCATION\n    %% ----------------------------------------------------------\n\n    class Country {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String iso2\n        +String iso3\n        +String phoneCode\n        +Department[] departments\n    }\n\n    class Department {\n        &lt;&lt;Model&gt;&gt;\n        +Number countryId\n        +String name\n        +String code\n        +Country country\n        +City[] cities\n    }\n\n    class City {\n        &lt;&lt;Model&gt;&gt;\n        +Number departmentId\n        +String name\n        +String code\n        +Department department\n        +UserAddress[] addresses\n    }\n\n    class UserAddress {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number cityId\n        +String label\n        +String line1\n        +String line2\n        +String postalCode\n        +Boolean isPrimary\n        +User user\n        +City city\n    }\n\n    %% ----------------------------------------------------------\n    %% DISCOVERY\n    %% ----------------------------------------------------------\n\n    class Tag {\n        &lt;&lt;Model&gt;&gt;\n        +String name\n        +String slug\n        +Publication[] publications\n        +PublicationTag[] publicationLinks\n    }\n\n    class PublicationTag {\n        &lt;&lt;JoinTable&gt;&gt;\n        +Number publicationId\n        +Number tagId\n        +Publication publication\n        +Tag tag\n    }\n\n    class Favorite {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +Number publicationId\n        +User user\n        +Publication publication\n    }\n\n    %% ----------------------------------------------------------\n    %% NOTIFICATIONS &amp; MODERATION\n    %% ----------------------------------------------------------\n\n    class Notification {\n        &lt;&lt;Model&gt;&gt;\n        +Number userId\n        +String type\n        +String title\n        +String message\n        +Number relatedPublicationId\n        +Boolean isRead\n        +Date readAt\n        +User recipient\n        +Publication relatedPublication\n        +markAsRead() void\n    }\n\n    class Report {\n        &lt;&lt;Model&gt;&gt;\n        +Number reporterId\n        +Number publicationId\n        +Number commentId\n        +String reason\n        +String details\n        +ReportStatus status\n        +Number reviewedBy\n        +Date reviewedAt\n        +User reporter\n        +User reviewer\n        +Publication publication\n        +Comment comment\n        +approve(reviewer) void\n        +dismiss(reviewer) void\n    }\n\n    %% ==========================================================\n    %% GENERALIZATION (inheritance)\n    %% ==========================================================\n\n    Model &lt;|-- User\n    Model &lt;|-- Category\n    Model &lt;|-- Publication\n    Model &lt;|-- Like\n    Model &lt;|-- Rating\n    Model &lt;|-- Comment\n    Model &lt;|-- Role\n    Model &lt;|-- Permission\n    Model &lt;|-- UserRole\n    Model &lt;|-- RolePermission\n    Model &lt;|-- DocumentType\n    Model &lt;|-- UserDocument\n    Model &lt;|-- Country\n    Model &lt;|-- Department\n    Model &lt;|-- City\n    Model &lt;|-- UserAddress\n    Model &lt;|-- Tag\n    Model &lt;|-- PublicationTag\n    Model &lt;|-- Favorite\n    Model &lt;|-- Notification\n    Model &lt;|-- Report\n\n    %% ==========================================================\n    %% COMPOSITION (FK NOT NULL + ON DELETE CASCADE)\n    %% ==========================================================\n\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Publication       : authors\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Like              : gives\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Rating            : rates\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Comment           : writes\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Favorite          : saves\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Notification      : receives\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; UserRole          : assigned\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; UserDocument      : owns\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; UserAddress       : lives at\n    User \&quot;1\&quot; *-- \&quot;0..*\&quot; Report            : submits (reporter)\n\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; Like            : receives\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; Rating          : receives\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; Comment         : receives\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; Favorite        : saved in\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; PublicationTag  : has\n    Publication \&quot;1\&quot; *-- \&quot;0..*\&quot; Report          : targeted by\n\n    Comment \&quot;1\&quot; *-- \&quot;0..*\&quot; Report            : targeted by\n\n    Role \&quot;1\&quot; *-- \&quot;0..*\&quot; UserRole             : grants user\n    Role \&quot;1\&quot; *-- \&quot;0..*\&quot; RolePermission       : grants perm\n    Permission \&quot;1\&quot; *-- \&quot;0..*\&quot; RolePermission : granted by\n\n    Country \&quot;1\&quot; *-- \&quot;0..*\&quot; Department        : has\n    Department \&quot;1\&quot; *-- \&quot;0..*\&quot; City           : has\n\n    Tag \&quot;1\&quot; *-- \&quot;0..*\&quot; PublicationTag        : labels\n\n    %% ==========================================================\n    %% AGGREGATION (FK nullable / ON DELETE SET NULL / RESTRICT)\n    %% ==========================================================\n\n    Category \&quot;1\&quot; o-- \&quot;0..*\&quot; Publication         : classifies\n    DocumentType \&quot;1\&quot; o-- \&quot;0..*\&quot; UserDocument    : classifies\n    City \&quot;1\&quot; o-- \&quot;0..*\&quot; UserAddress             : located in\n    Publication \&quot;0..1\&quot; o-- \&quot;0..*\&quot; Notification  : refers to\n    User \&quot;0..1\&quot; o-- \&quot;0..*\&quot; Report               : reviews (reviewer)\n\n    %% ==========================================================\n    %% ASSOCIATION (m:n resolved through join tables)\n    %% ==========================================================\n\n    User \&quot;0..*\&quot; -- \&quot;0..*\&quot; Role        : &lt;&lt;m:n via UserRole&gt;&gt;\n    Role \&quot;0..*\&quot; -- \&quot;0..*\&quot; Permission  : &lt;&lt;m:n via RolePermission&gt;&gt;\n    Publication \&quot;0..*\&quot; -- \&quot;0..*\&quot; Tag  : &lt;&lt;m:n via PublicationTag&gt;&gt;\n\n    %% ==========================================================\n    %% DEPENDENCY (type usage)\n    %% ==========================================================\n\n    Publication ..&gt; PublicationType : type\n    Report      ..&gt; ReportStatus    : status&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6_qng3kcBZlu8R-y70OT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
