# ==========================================
# APPLICATION
# ==========================================

APP_PORT=3377
NODE_ENV=development

# ==========================================
# DATABASE - POSTGRESQL
# ==========================================

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=food_forum
DB_USER=food_forum_user
DB_PASSWORD=local_dev_password

# ==========================================
# SEQUELIZE CONNECTION POOL
# ==========================================

DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ==========================================
# SECURITY
# ==========================================

# Replace this value with a long random string in your local .env file.
AUTH_APP_JWT_SECRET_KEY=replace_with_a_long_random_string
AUTH_APP_JWT_EXPIRES_IN=24h

# ==========================================
# IMAGE UPLOADS
# ==========================================

UPLOAD_MAX_SIZE_MB=5
