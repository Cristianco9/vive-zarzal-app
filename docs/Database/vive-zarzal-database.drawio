<mxfile host="Electron" pages="2">
  <diagram name="relational-model" id="aiT3kSOgCknYwAyRmiEX">
    <mxGraphModel dx="2312" dy="1928" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ============================================================\n    %% CORE FORUM\n    %% ============================================================\n\n    USERS ||--o{ PUBLICATIONS        : \&quot;author\&quot;\n    USERS ||--o{ LIKES               : \&quot;gives\&quot;\n    USERS ||--o{ RATINGS             : \&quot;rates\&quot;\n    USERS ||--o{ COMMENTS            : \&quot;writes\&quot;\n    USERS ||--o{ FAVORITES           : \&quot;saves\&quot;\n    USERS ||--o{ NOTIFICATIONS       : \&quot;receives\&quot;\n    USERS ||--o{ USER_ROLES          : \&quot;has\&quot;\n    USERS ||--o{ USER_DOCUMENTS      : \&quot;owns\&quot;\n    USERS ||--o{ USER_ADDRESSES      : \&quot;has\&quot;\n    USERS ||--o{ REPORTS             : \&quot;submits (reporter)\&quot;\n    USERS ||--o{ REPORTS             : \&quot;reviews (reviewer)\&quot;\n\n    CATEGORIES ||--o{ PUBLICATIONS   : \&quot;classifies\&quot;\n\n    PUBLICATIONS ||--o{ LIKES             : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ RATINGS           : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ COMMENTS          : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ FAVORITES         : \&quot;saved in\&quot;\n    PUBLICATIONS ||--o{ PUBLICATION_TAGS  : \&quot;tagged\&quot;\n    PUBLICATIONS ||--o{ NOTIFICATIONS     : \&quot;related to\&quot;\n    PUBLICATIONS ||--o{ REPORTS           : \&quot;reported\&quot;\n\n    COMMENTS ||--o{ REPORTS          : \&quot;reported\&quot;\n\n    %% ============================================================\n    %% ACCESS CONTROL\n    %% ============================================================\n\n    ROLES       ||--o{ USER_ROLES         : \&quot;assigned to\&quot;\n    ROLES       ||--o{ ROLE_PERMISSIONS   : \&quot;grants\&quot;\n    PERMISSIONS ||--o{ ROLE_PERMISSIONS   : \&quot;granted by\&quot;\n\n    %% ============================================================\n    %% IDENTITY\n    %% ============================================================\n\n    DOCUMENT_TYPES ||--o{ USER_DOCUMENTS : \&quot;typed as\&quot;\n\n    %% ============================================================\n    %% LOCATION\n    %% ============================================================\n\n    COUNTRIES   ||--o{ DEPARTMENTS     : \&quot;has\&quot;\n    DEPARTMENTS ||--o{ CITIES          : \&quot;has\&quot;\n    CITIES      ||--o{ USER_ADDRESSES  : \&quot;located in\&quot;\n\n    %% ============================================================\n    %% DISCOVERY\n    %% ============================================================\n\n    TAGS ||--o{ PUBLICATION_TAGS : \&quot;labels\&quot;\n\n    %% ============================================================\n    %% ENTITIES\n    %% ============================================================\n\n    USERS {\n        int      id          PK\n        varchar  first_name  \&quot;varchar(80) not null\&quot;\n        varchar  last_name   \&quot;varchar(80) not null\&quot;\n        varchar  username    UK \&quot;varchar(50) unique\&quot;\n        varchar  email       UK \&quot;varchar(150) unique\&quot;\n        varchar  password    \&quot;bcrypt hash\&quot;\n        text     bio         \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    CATEGORIES {\n        int      id          PK\n        varchar  name        UK \&quot;varchar(80) unique\&quot;\n        varchar  slug        UK \&quot;varchar(80) unique\&quot;\n        varchar  description \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    PUBLICATIONS {\n        int      id            PK\n        int      user_id       FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      category_id   FK \&quot;-&gt; categories.id ON DELETE RESTRICT\&quot;\n        varchar  type          \&quot;CHECK dish|recipe\&quot;\n        varchar  title         \&quot;varchar(150)\&quot;\n        text     description\n        varchar  image_url     \&quot;nullable\&quot;\n        text     ingredients   \&quot;required for recipes\&quot;\n        text     instructions  \&quot;required for recipes\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    LIKES {\n        int      id             PK\n        int      user_id        FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    RATINGS {\n        int      id             PK\n        int      user_id        FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE\&quot;\n        int      score          \&quot;CHECK 1..5\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    COMMENTS {\n        int      id             PK\n        int      user_id        FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE\&quot;\n        text     content\n        datetime created_at\n        datetime updated_at\n    }\n\n    ROLES {\n        int      id          PK\n        varchar  name        UK \&quot;varchar(50) unique\&quot;\n        varchar  slug        UK \&quot;varchar(50) unique\&quot;\n        varchar  description \&quot;nullable\&quot;\n        boolean  is_system   \&quot;default false\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    PERMISSIONS {\n        int      id          PK\n        varchar  name        UK \&quot;varchar(100) unique\&quot;\n        varchar  slug        UK \&quot;varchar(100) unique\&quot;\n        varchar  description \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    ROLE_PERMISSIONS {\n        int      id            PK\n        int      role_id       FK \&quot;-&gt; roles.id ON DELETE CASCADE\&quot;\n        int      permission_id FK \&quot;-&gt; permissions.id ON DELETE CASCADE\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    USER_ROLES {\n        int      id        PK\n        int      user_id   FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      role_id   FK \&quot;-&gt; roles.id ON DELETE CASCADE\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    DOCUMENT_TYPES {\n        int      id          PK\n        varchar  name        UK \&quot;varchar(100) unique\&quot;\n        varchar  code        UK \&quot;varchar(20) unique\&quot;\n        varchar  description \&quot;nullable\&quot;\n        boolean  is_active   \&quot;default true\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    USER_DOCUMENTS {\n        int      id                PK\n        int      user_id           FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      document_type_id  FK \&quot;-&gt; document_types.id ON DELETE RESTRICT\&quot;\n        varchar  document_number   \&quot;varchar(50)\&quot;\n        date     issued_at         \&quot;nullable\&quot;\n        date     expires_at        \&quot;nullable\&quot;\n        boolean  is_verified       \&quot;default false\&quot;\n        datetime verified_at       \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    COUNTRIES {\n        int      id         PK\n        varchar  name       UK \&quot;varchar(100) unique\&quot;\n        varchar  iso2       UK \&quot;char(2) unique\&quot;\n        varchar  iso3       UK \&quot;char(3) unique, nullable\&quot;\n        varchar  phone_code \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    DEPARTMENTS {\n        int      id         PK\n        int      country_id FK \&quot;-&gt; countries.id ON DELETE CASCADE\&quot;\n        varchar  name       \&quot;varchar(100)\&quot;\n        varchar  code       \&quot;varchar(10) nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    CITIES {\n        int      id            PK\n        int      department_id FK \&quot;-&gt; departments.id ON DELETE CASCADE\&quot;\n        varchar  name          \&quot;varchar(100)\&quot;\n        varchar  code          \&quot;varchar(10) nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    USER_ADDRESSES {\n        int      id          PK\n        int      user_id     FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      city_id     FK \&quot;-&gt; cities.id ON DELETE RESTRICT\&quot;\n        varchar  label       \&quot;nullable\&quot;\n        varchar  line1       \&quot;varchar(255)\&quot;\n        varchar  line2       \&quot;nullable\&quot;\n        varchar  postal_code \&quot;nullable\&quot;\n        boolean  is_primary  \&quot;default false\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    TAGS {\n        int      id   PK\n        varchar  name UK \&quot;varchar(50) unique\&quot;\n        varchar  slug UK \&quot;varchar(60) unique\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    PUBLICATION_TAGS {\n        int      id             PK\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE\&quot;\n        int      tag_id         FK \&quot;-&gt; tags.id ON DELETE CASCADE\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    FAVORITES {\n        int      id             PK\n        int      user_id        FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    NOTIFICATIONS {\n        int      id                     PK\n        int      user_id                FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        varchar  type                   \&quot;varchar(50)\&quot;\n        varchar  title                  \&quot;varchar(150)\&quot;\n        text     message\n        int      related_publication_id FK \&quot;-&gt; publications.id ON DELETE SET NULL, nullable\&quot;\n        boolean  is_read                \&quot;default false\&quot;\n        datetime read_at                \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    REPORTS {\n        int      id             PK\n        int      reporter_id    FK \&quot;-&gt; users.id ON DELETE CASCADE\&quot;\n        int      publication_id FK \&quot;-&gt; publications.id ON DELETE CASCADE, nullable\&quot;\n        int      comment_id     FK \&quot;-&gt; comments.id ON DELETE CASCADE, nullable\&quot;\n        varchar  reason         \&quot;varchar(100)\&quot;\n        text     details        \&quot;nullable\&quot;\n        varchar  status         \&quot;varchar(20) default &#39;pending&#39;\&quot;\n        int      reviewed_by    FK \&quot;-&gt; users.id ON DELETE SET NULL, nullable\&quot;\n        datetime reviewed_at    \&quot;nullable\&quot;\n        datetime created_at\n        datetime updated_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Gtgc9vrj_3qhksrBELmf-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
