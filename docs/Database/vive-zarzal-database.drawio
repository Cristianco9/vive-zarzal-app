  <diagram id="xBEgHKIzzJ-8pujf7co8" name="entity-relationship">
    <mxGraphModel dx="3372" dy="3444" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    %% ──────────────────────────────────────────────\n    %% CORE FORUM\n    %% ──────────────────────────────────────────────\n\n    USERS {\n        int       id          PK\n        string    first_name\n        string    last_name\n        string    username    UK\n        string    email       UK\n        string    password\n        text      bio\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    CATEGORIES {\n        int       id          PK\n        string    name        UK\n        string    slug        UK\n        string    description\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    PUBLICATIONS {\n        int       id            PK\n        int       user_id       FK\n        int       category_id   FK\n        string    type\n        string    title\n        text      description\n        string    image_url\n        text      ingredients\n        text      instructions\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    LIKES {\n        int       id              PK\n        int       user_id         FK\n        int       publication_id  FK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    RATINGS {\n        int       id              PK\n        int       user_id         FK\n        int       publication_id  FK\n        int       score\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    COMMENTS {\n        int       id              PK\n        int       user_id         FK\n        int       publication_id  FK\n        text      content\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% ACCESS CONTROL\n    %% ──────────────────────────────────────────────\n\n    ROLES {\n        int       id          PK\n        string    name        UK\n        string    slug        UK\n        string    description\n        boolean   is_system\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    PERMISSIONS {\n        int       id          PK\n        string    name        UK\n        string    slug        UK\n        string    description\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    ROLE_PERMISSIONS {\n        int       id             PK\n        int       role_id        FK\n        int       permission_id  FK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    USER_ROLES {\n        int       id          PK\n        int       user_id     FK\n        int       role_id     FK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% IDENTITY\n    %% ──────────────────────────────────────────────\n\n    DOCUMENT_TYPES {\n        int       id          PK\n        string    name        UK\n        string    code        UK\n        string    description\n        boolean   is_active\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    USER_DOCUMENTS {\n        int       id                PK\n        int       user_id           FK\n        int       document_type_id  FK\n        string    document_number\n        date      issued_at\n        date      expires_at\n        boolean   is_verified\n        datetime  verified_at\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% LOCATION\n    %% ──────────────────────────────────────────────\n\n    COUNTRIES {\n        int       id          PK\n        string    name        UK\n        string    iso2        UK\n        string    iso3        UK\n        string    phone_code\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    DEPARTMENTS {\n        int       id          PK\n        int       country_id  FK\n        string    name\n        string    code\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    CITIES {\n        int       id             PK\n        int       department_id  FK\n        string    name\n        string    code\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    USER_ADDRESSES {\n        int       id           PK\n        int       user_id      FK\n        int       city_id      FK\n        string    label\n        string    line1\n        string    line2\n        string    postal_code\n        boolean   is_primary\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% DISCOVERY\n    %% ──────────────────────────────────────────────\n\n    TAGS {\n        int       id          PK\n        string    name        UK\n        string    slug        UK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    PUBLICATION_TAGS {\n        int       id              PK\n        int       publication_id  FK\n        int       tag_id          FK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    FAVORITES {\n        int       id              PK\n        int       user_id         FK\n        int       publication_id  FK\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% NOTIFICATIONS &amp; MODERATION\n    %% ──────────────────────────────────────────────\n\n    NOTIFICATIONS {\n        int       id                      PK\n        int       user_id                 FK\n        string    type\n        string    title\n        text      message\n        int       related_publication_id  FK\n        boolean   is_read\n        datetime  read_at\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    REPORTS {\n        int       id              PK\n        int       reporter_id     FK\n        int       publication_id  FK\n        int       comment_id      FK\n        string    reason\n        text      details\n        string    status\n        int       reviewed_by     FK\n        datetime  reviewed_at\n        datetime  created_at\n        datetime  updated_at\n    }\n\n    %% ──────────────────────────────────────────────\n    %% RELATIONSHIPS\n    %% ──────────────────────────────────────────────\n\n    USERS ||--o{ PUBLICATIONS       : \&quot;author\&quot;\n    USERS ||--o{ LIKES              : \&quot;gives\&quot;\n    USERS ||--o{ RATINGS            : \&quot;rates\&quot;\n    USERS ||--o{ COMMENTS           : \&quot;writes\&quot;\n    USERS ||--o{ FAVORITES          : \&quot;saves\&quot;\n    USERS ||--o{ NOTIFICATIONS      : \&quot;receives\&quot;\n    USERS ||--o{ USER_ROLES         : \&quot;has\&quot;\n    USERS ||--o{ USER_DOCUMENTS     : \&quot;owns\&quot;\n    USERS ||--o{ USER_ADDRESSES     : \&quot;lives at\&quot;\n    USERS ||--o{ REPORTS            : \&quot;submits\&quot;\n    USERS ||--o{ REPORTS            : \&quot;reviews\&quot;\n\n    CATEGORIES ||--o{ PUBLICATIONS  : \&quot;groups\&quot;\n\n    PUBLICATIONS ||--o{ LIKES             : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ RATINGS           : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ COMMENTS          : \&quot;receives\&quot;\n    PUBLICATIONS ||--o{ FAVORITES         : \&quot;saved in\&quot;\n    PUBLICATIONS ||--o{ PUBLICATION_TAGS  : \&quot;has\&quot;\n    PUBLICATIONS ||--o{ NOTIFICATIONS     : \&quot;referenced by\&quot;\n    PUBLICATIONS ||--o{ REPORTS           : \&quot;is target\&quot;\n\n    COMMENTS ||--o{ REPORTS  : \&quot;is target\&quot;\n\n    ROLES       ||--o{ USER_ROLES         : \&quot;assigned to\&quot;\n    ROLES       ||--o{ ROLE_PERMISSIONS   : \&quot;grants\&quot;\n    PERMISSIONS ||--o{ ROLE_PERMISSIONS   : \&quot;granted by\&quot;\n\n    DOCUMENT_TYPES ||--o{ USER_DOCUMENTS  : \&quot;classifies\&quot;\n\n    COUNTRIES   ||--o{ DEPARTMENTS  : \&quot;has\&quot;\n    DEPARTMENTS ||--o{ CITIES       : \&quot;has\&quot;\n    CITIES      ||--o{ USER_ADDRESSES : \&quot;located in\&quot;\n\n    TAGS ||--o{ PUBLICATION_TAGS  : \&quot;labels\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pLBNMLCjx1aTCXXFDD0w-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
